{"id": "confucius-1-1-learn", "sage": "confucius", "text": "Is it not pleasant to learn with a constant perseverance and application?", "citation": "Analects 1.1", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 1.1", "themes": ["learning", "habit"]}
{"id": "confucius-1-1-friends", "sage": "confucius", "text": "Is it not delightful to have friends coming from distant quarters?", "citation": "Analects 1.1", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 1.1", "themes": ["friendship"]}
{"id": "confucius-1-1-no-note", "sage": "confucius", "text": "Is he not a man of complete virtue, who feels no discomposure though men may take no note of him?", "citation": "Analects 1.1", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 1.1", "themes": ["fame", "humility", "contentment"]}
{"id": "confucius-1-3-fine-words", "sage": "confucius", "text": "Fine words and an insinuating appearance are seldom associated with true virtue.", "citation": "Analects 1.3", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 1.3", "themes": ["speech", "honesty"]}
{"id": "confucius-1-8-faults", "sage": "confucius", "text": "When you have faults, do not fear to abandon them.", "citation": "Analects 1.8", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 1.8", "themes": ["honesty", "self-discipline", "criticism"]}
{"id": "confucius-1-16-know-men", "sage": "confucius", "text": "I will not be afflicted at men's not knowing me; I will be afflicted that I do not know men.", "citation": "Analects 1.16", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 1.16", "themes": ["fame", "humility", "friendship"]}
{"id": "confucius-2-4-fifteen", "sage": "confucius", "text": "At fifteen, I had my mind bent on learning.", "citation": "Analects 2.4", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 2.4", "themes": ["learning", "time"]}
{"id": "confucius-2-4-seventy", "sage": "confucius", "text": "At seventy, I could follow what my heart desired, without transgressing what was right.", "citation": "Analects 2.4", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 2.4", "themes": ["freedom", "self-discipline", "time"]}
{"id": "confucius-2-11-old-new", "sage": "confucius", "text": "If a man keeps cherishing his old knowledge, so as continually to be acquiring new, he may be a teacher of others.", "citation": "Analects 2.11", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 2.11", "themes": ["learning"]}
{"id": "confucius-2-15-thought", "sage": "confucius", "text": "Learning without thought is labour lost; thought without learning is perilous.", "citation": "Analects 2.15", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 2.15", "themes": ["learning"]}
{"id": "confucius-2-17-knowledge", "sage": "confucius", "text": "When you know a thing, to hold that you know it; and when you do not know a thing, to allow that you do not know it;-- this is knowledge.", "citation": "Analects 2.17", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 2.17", "themes": ["honesty", "learning", "humility"]}
{"id": "confucius-2-24-courage", "sage": "confucius", "text": "To see what is right and not to do it is want of courage.", "citation": "Analects 2.24", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 2.24", "themes": ["duty", "honesty"]}
{"id": "confucius-4-5-riches", "sage": "confucius", "text": "Riches and honours are what men desire. If it cannot be obtained in the proper way, they should not be held.", "citation": "Analects 4.5", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 4.5", "themes": ["money", "desire", "honesty"]}
{"id": "confucius-4-14-place", "sage": "confucius", "text": "I am not concerned that I have no place, I am concerned how I may fit myself for one.", "citation": "Analects 4.14", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 4.14", "themes": ["work", "fame", "humility"]}
{"id": "confucius-4-15-unity", "sage": "confucius", "text": "my doctrine is that of an all-pervading unity.", "citation": "Analects 4.15", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 4.15", "themes": ["the-way"]}
{"id": "confucius-4-16-gain", "sage": "confucius", "text": "The mind of the superior man is conversant with righteousness; the mind of the mean man is conversant with gain.", "citation": "Analects 4.16", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 4.16", "themes": ["money", "duty"]}
{"id": "confucius-4-17-worth", "sage": "confucius", "text": "When we see men of worth, we should think of equalling them; when we see men of a contrary character, we should turn inwards and examine ourselves.", "citation": "Analects 4.17", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 4.17", "themes": ["learning", "criticism", "the-self"]}
{"id": "confucius-4-25-neighbors", "sage": "confucius", "text": "Virtue is not left to stand alone. He who practises it will have neighbors.", "citation": "Analects 4.25", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 4.25", "themes": ["friendship", "honesty"]}
{"id": "confucius-5-26-accuse", "sage": "confucius", "text": "I have not yet seen one who could perceive his faults, and inwardly accuse himself.", "citation": "Analects 5.26", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 5.26", "themes": ["honesty", "criticism", "the-self"]}
{"id": "confucius-6-18-delight", "sage": "confucius", "text": "They who know the truth are not equal to those who love it, and they who love it are not equal to those who delight in it.", "citation": "Analects 6.18", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 6.18", "themes": ["learning", "pleasure"]}
{"id": "confucius-6-20-spirits", "sage": "confucius", "text": "while respecting spiritual beings, to keep aloof from them, may be called wisdom.", "citation": "Analects 6.20", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 6.20", "themes": ["duty", "the-way"], "note": "The sentence begins: to give one's self earnestly to the duties due to men."}
{"id": "confucius-6-20-difficulty", "sage": "confucius", "text": "The man of virtue makes the difficulty to be overcome his first business, and success only a subsequent consideration", "citation": "Analects 6.20", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 6.20", "themes": ["work", "adversity"]}
{"id": "confucius-7-1-transmitter", "sage": "confucius", "text": "A transmitter and not a maker, believing in and loving the ancients", "citation": "Analects 7.1", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 7.1", "themes": ["humility", "learning"]}
{"id": "confucius-7-8-eager", "sage": "confucius", "text": "I do not open up the truth to one who is not eager to get knowledge", "citation": "Analects 7.8", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 7.8", "themes": ["learning"]}
{"id": "confucius-7-15-pillow", "sage": "confucius", "text": "with water to drink, and my bended arm for a pillow;-- I have still joy in the midst of these things.", "citation": "Analects 7.15", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 7.15", "themes": ["simplicity", "contentment", "money"]}
{"id": "confucius-7-15-cloud", "sage": "confucius", "text": "Riches and honours acquired by unrighteousness, are to me as a floating cloud.", "citation": "Analects 7.15", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 7.15", "themes": ["money", "honesty", "fame"]}
{"id": "confucius-7-21-teachers", "sage": "confucius", "text": "When I walk along with two others, they may serve me as my teachers.", "citation": "Analects 7.21", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 7.21", "themes": ["learning", "friendship", "humility"], "note": "7.22 in most modern editions."}
{"id": "confucius-7-36-composed", "sage": "confucius", "text": "The superior man is satisfied and composed; the mean man is always full of distress.", "citation": "Analects 7.36", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 7.36", "themes": ["contentment", "anxiety"]}
{"id": "confucius-9-16-stream", "sage": "confucius", "text": "It passes on just like this, not ceasing day or night!", "citation": "Analects 9.16", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 9.16", "themes": ["impermanence", "time", "change"], "note": "Said standing by a stream."}
{"id": "confucius-9-25-will", "sage": "confucius", "text": "the will of even a common man cannot be taken from him.", "citation": "Analects 9.25", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 9.25", "themes": ["freedom", "self-discipline"]}
{"id": "confucius-9-27-pine", "sage": "confucius", "text": "the year becomes cold, then we know how the pine and the cypress are the last to lose their leaves.", "citation": "Analects 9.27", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 9.27", "themes": ["adversity", "friendship"]}
{"id": "confucius-11-11-life", "sage": "confucius", "text": "While you do not know life, how can you know about death?", "citation": "Analects 11.11", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 11.11", "themes": ["death", "attention"], "note": "11.12 in most modern editions."}
{"id": "confucius-12-1-subdue", "sage": "confucius", "text": "To subdue one's self and return to propriety, is perfect virtue.", "citation": "Analects 12.1", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 12.1", "themes": ["self-discipline", "duty"]}
{"id": "confucius-12-2-not-wish", "sage": "confucius", "text": "not to do to others as you would not wish done to yourself", "citation": "Analects 12.2", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 12.2", "themes": ["compassion", "duty"]}
{"id": "confucius-12-19-grass", "sage": "confucius", "text": "The grass must bend, when the wind blows across it.", "citation": "Analects 12.19", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 12.19", "themes": ["leadership"], "note": "The wind is the character of those who lead, the grass that of those they lead."}
{"id": "confucius-13-3-names", "sage": "confucius", "text": "What is necessary is to rectify names.", "citation": "Analects 13.3", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 13.3", "themes": ["speech", "leadership", "honesty"]}
{"id": "confucius-13-6-conduct", "sage": "confucius", "text": "When a prince's personal conduct is correct, his government is effective without the issuing of orders.", "citation": "Analects 13.6", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 13.6", "themes": ["leadership", "honesty"]}
{"id": "confucius-13-13-rectify", "sage": "confucius", "text": "If he cannot rectify himself, what has he to do with rectifying others?", "citation": "Analects 13.13", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 13.13", "themes": ["leadership", "self-discipline"]}
{"id": "confucius-14-29-modest", "sage": "confucius", "text": "The superior man is modest in his speech, but exceeds in his actions.", "citation": "Analects 14.29", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 14.29", "themes": ["speech", "work", "humility"]}
{"id": "confucius-14-36-justice", "sage": "confucius", "text": "Recompense injury with justice, and recompense kindness with kindness.", "citation": "Analects 14.36", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 14.36", "themes": ["anger", "compassion"], "note": "His answer to someone who proposed repaying injury with kindness."}
{"id": "confucius-15-20-seeks", "sage": "confucius", "text": "What the superior man seeks, is in himself. What the mean man seeks, is in others.", "citation": "Analects 15.20", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 15.20", "themes": ["the-self", "criticism"]}
{"id": "confucius-15-23-reciprocity", "sage": "confucius", "text": "What you do not want done to yourself, do not do to others.", "citation": "Analects 15.23", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 15.23", "themes": ["compassion", "duty", "friendship"], "note": "15.24 in most modern editions. Asked for one word to practise for life, he answers reciprocity (shu), then this."}
{"id": "confucius-15-29-reform", "sage": "confucius", "text": "To have faults and not to reform them,-- this, indeed, should be pronounced having faults.", "citation": "Analects 15.29", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 15.29", "themes": ["honesty", "criticism", "self-discipline"]}
{"id": "confucius-15-38-classes", "sage": "confucius", "text": "In teaching there should be no distinction of classes.", "citation": "Analects 15.38", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 15.38", "themes": ["learning", "compassion"]}
{"id": "confucius-16-4-friendships", "sage": "confucius", "text": "There are three friendships which are advantageous, and three which are injurious. Friendship with the upright; friendship with the sincere", "citation": "Analects 16.4", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 16.4", "themes": ["friendship"]}
{"id": "confucius-17-2-nature", "sage": "confucius", "text": "By nature, men are nearly alike; by practice, they get to be wide apart.", "citation": "Analects 17.2", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 17.2", "themes": ["habit", "learning"]}
{"id": "confucius-10-12-stable", "sage": "confucius", "text": "'Has any man been hurt?' He did not ask about the horses.", "citation": "Analects 10.12", "work": "Analects", "translator": "James Legge", "year": 1893, "source_file": "sources/confucius/legge-analects.txt", "under_heading": "Analects 10.12", "themes": ["compassion", "leadership", "money"], "note": "Told about Confucius by his disciples: the stable had burned down while he was at court."}
